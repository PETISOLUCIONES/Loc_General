<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Template-->
    <template id="customer_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <h4 style="text-align:center;"><t t-out="txt_statement_of_account"/></h4>
                <table class="table table-borderless" style="margin-top:20px;">
                    <tr>
                        <td style="width:600px;">
                            <p style=" line-height:2px;" t-if="partner_name">
                                <t t-out="partner_name"/>
                            </p>
                            <p style=" line-height:2px;" t-if="partner_street">
                                <t t-out="partner_street"/>
                            </p>
                            <p style=" line-height:2px;" t-if="partner_street2">
                                <t t-out="partner_street2"/>
                            </p>
                            <p style=" line-height:2px;" t-if="partner_city or partner_zip">
                                <t t-if="partner_city" t-out="partner_city"/>
                                <t t-if="partner_zip" t-out="partner_zip"/>
                            </p>
                            <p style=" line-height:2px;"  t-if="partner_state_id">
                                <t t-out="partner_state_id"/>
                            </p>
                            <p style=" line-height:2px;" t-if="partner_country_id">
                                <t t-out="partner_country_id"/>
                            </p>
                        </td>
                        <td rowspan="6">
                            <span><t t-out="txt_as_of"/>
                                <t t-out="today_date"/>
                            </span>
                        </td>
                    </tr>
                </table>
                <table style="border:solid 1px gainsboro;width:100%; table-layout: fixed;height:100%;margin-top:20px;">
                    <thead>
                        <tr style="height:40px;border-bottom:solid 2px black;">
                            <td style="vertical-align: middle;text-align:center;">
                                <strong><t t-out="txt_invoice_date"/></strong>
                            </td>
                            <td style="vertical-align: middle;text-align:center;">
                                <strong><t t-out="txt_due_date"/></strong>
                            </td>
                            <td style="vertical-align: middle;text-align:center;">
                                <strong><t t-out="txt_invoice"/></strong>
                            </td>
                            <td style="vertical-align: middle;text-align:right;">
                                <strong style="margin-right:5px;"><t t-out="txt_invoice_amount"/></strong>
                            </td>
                            <td style="vertical-align: middle;text-align:right;margin-right:10px;">
                                <strong style="margin-right:5px;"><t t-out="txt_payment_amount"/></strong>
                            </td>
                            <td style="vertical-align: middle;text-align:right;margin-right:10px;">
                                <strong style="margin-right:5px;"><t t-out="txt_balance_due"/></strong>
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="invoice">
                            <tr style="height:40px;">
                                <td style="vertical-align: middle;text-align:center;">
                                    <span t-out="invoice['invoice_date']"/>
                                </td>
                                <td style="vertical-align: middle;text-align:center;">
                                    <span t-out="invoice['due_date']"/>
                                </td>
                                <td style="vertical-align: middle;text-align:center;">
                                    <span t-out="invoice['invoice_id']"/>
                                </td>
                                <td style="text-align:right;vertical-align: middle;">
                                    <span t-out="currency"/>
                                    <span style="margin-right:5px;" t-out="invoice['amount']"/>
                                </td>
                                <td style="text-align:right;vertical-align: middle;middle;">
                                    <span t-out="currency"/>
                                    <span style="margin-right:5px;" t-out="invoice['payment_amount']"/>
                                </td>
                                <td style="text-align:right;vertical-align: middle;middle;">
                                    <span t-out="currency"/>
                                    <span style="margin-right:5px;" t-out="invoice['balance_due']"/>
                                </td>
                            </tr>
                        </t>
                        <!-- Total row -->
                        <tr style="height:40px;">
                            <td colspan="3" style="text-align:right;vertical-align: middle;">
                                <strong style="margin-right:5px;"><t t-out="txt_total"/></strong>
                            </td>
                            <td style="text-align:right;vertical-align: middle;">
                                <strong>
                                    <span t-out="currency"/>
                                    <span style="margin-right:5px;" t-out="total_amount"/>
                                </strong>
                            </td>
                            <td style="text-align:right;vertical-align: middle;">
                                <strong>
                                    <span t-out="currency"/>
                                    <span style="margin-right:5px;" t-out="total_payment"/>
                                </strong>
                            </td>
                            <td style="text-align:right;vertical-align: middle;">
                                <strong>
                                    <span t-out="currency"/>
                                    <span style="margin-right:5px;" t-out="total_balance"/>
                                </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </t>
    </template>
    <!-- Report Action -->
    <record id="customer_report_template_action" model="ir.actions.report">
        <field name="name">Customer Statement Report</field>
        <field name="model">customer.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tk_customer_statements.customer_report_template</field>
        <field name="report_file">tk_customer_statements.customer_report_template</field>
        <field name="binding_model_id" ref="model_customer_statement_wizard"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
