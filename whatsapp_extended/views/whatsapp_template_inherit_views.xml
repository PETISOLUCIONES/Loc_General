<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="wa_template_form_inherit_chatbot" model="ir.ui.view">
            <field name="name">whatsapp.template.view.form.inherit</field>
            <field name="model">whatsapp.template</field>
            <field name="inherit_id" ref="whatsapp.whatsapp_template_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='template_type']" position="after">
                    <field name="template_category"/>
                </xpath>

                <xpath expr="//page[@name='Variables']" position="after">
                    <page id="interactive" name="Interactive" invisible="template_category != 'interactive'">
                        <field name="wa_interactive_ids" readonly="status != 'draft'">
                            <list>
                                <field name="interactive_type"/>
                                <field name="interactive_list_ids"/>
                                <field name="interactive_button_ids"/>
                                <field name="catalog_id"/>
                                <field name="interactive_product_list_ids"/>
                                <field name="product_retailer_id"/>
                            </list>
                        </field>
                    </page>
                </xpath>

                <xpath expr="//button[@name='button_submit_template']" position="after">
                    <button name="button_set_status_to_added"
                            string="Set Status To Added"
                            type="object"
                            invisible="status == 'approved'"
                            groups="whatsapp.group_whatsapp_admin"/>
                </xpath>

                <xpath expr="//field[@name='button_ids']" position="attributes">
                    <attribute name="readonly">template_category == 'interactive'</attribute>
                </xpath>

                <xpath expr="//field[@name='variable_ids']" position="attributes">
                    <attribute name="readonly">template_category == 'interactive'</attribute>
                </xpath>

                <xpath expr="//button[@name='button_submit_template']" position="attributes">
                    <attribute name="invisible">template_category == 'interactive' or status == 'approved'</attribute>
                </xpath>

                <xpath expr="//header" position="after">
                    <field name="is_system_template" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not is_system_template">
                        <p>
                            <i class="fa fa-exclamation-triangle"/>
                            Esta plantilla es modificada automáticamente por el sistema. Cualquier cambio manual puede ser sobrescrito o generar inconsistencias en su funcionamiento.
                        </p>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="wa_template_tree_inherit_chatbot" model="ir.ui.view">
            <field name="name">whatsapp.template.view.tree.inherit</field>
            <field name="model">whatsapp.template</field>
            <field name="inherit_id" ref="whatsapp.whatsapp_template_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="field[@name='status']" position="after">
                    <button name="send_pre_message_by_whatsapp" type="object" string="Send" class="oe_highlight"/>
                </xpath>

                <xpath expr="//field[@name='model_id']" position="after">
                    <field name="template_type" optional="hide"/>
                    <field name="template_category" optional="hide"/>
                </xpath>

                <xpath expr="//list" position="attributes">
                    <attribute name="expand">1</attribute>
                    <attribute name="default_order">name</attribute>
                </xpath>
            </field>
        </record>

        <record id="whatsapp.whatsapp_template_action" model="ir.actions.act_window">
            <field name="context">{'search_default_groupby_wa_account_id': 1}</field>
        </record>
    </data>
</odoo>